# Servidor
PORT=3001
APP_ENV=development

# Base de datos
# PostgreSQL de Docker en puerto 5434 (para no entrar en conflicto con PostgreSQL local en puerto 5432)
DATABASE_URL=postgres://inmobiliaria_user:password@localhost:5434/inmobiliaria?sslmode=disable

# Redis
# Para Docker
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=tu_secreto_super_seguro_cambialo_en_produccion

# Cloudflare R2
R2_ACCOUNT_ID=tu_account_id
R2_ACCESS_KEY_ID=tu_access_key
R2_SECRET_ACCESS_KEY=tu_secret_key
R2_BUCKET_NAME=inmobiliaria-fotos

# Evolution API (WhatsApp)
EVOLUTION_API_URL=http://localhost:8081
EVOLUTION_API_KEY=tu_api_key

# Wompi (Pagos)
WOMPI_PUBLIC_KEY=tu_public_key
WOMPI_PRIVATE_KEY=tu_private_key

# Gemini Flash
GEMINI_API_KEY=tu_gemini_key

# Google OAuth
GOOGLE_CLIENT_ID=REDACTED_GOOGLE_CLIENT_ID_2
GOOGLE_CLIENT_SECRET=REDACTED_GOOGLE_CLIENT_SECRET_2
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# Frontend
FRONTEND_URL=http://localhost:3000
