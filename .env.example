# Servidor
PORT=3001
APP_ENV=development

# Base de datos
# Para desarrollo local: postgres://usuario:password@localhost:5432/inmobiliaria?sslmode=disable
# Para Docker: postgres://inmobiliaria_user:password@postgres:5432/inmobiliaria?sslmode=disable
DATABASE_URL=postgres://inmobiliaria_user:password@postgres:5432/inmobiliaria?sslmode=disable

# Redis
# Para desarrollo local: redis://localhost:6379
# Para Docker: redis://redis:6379
REDIS_URL=redis://redis:6379

# JWT
JWT_SECRET=tu_secreto_super_seguro_cambialo_en_produccion

# Cloudflare R2
R2_ACCOUNT_ID=tu_account_id
R2_ACCESS_KEY_ID=tu_access_key
R2_SECRET_ACCESS_KEY=tu_secret_key
R2_BUCKET_NAME=inmobiliaria-fotos

# Evolution API (WhatsApp)
EVOLUTION_API_URL=http://localhost:8081
EVOLUTION_API_KEY=tu_api_key

# Wompi (Pagos)
WOMPI_PUBLIC_KEY=tu_public_key
WOMPI_PRIVATE_KEY=tu_private_key

# Gemini Flash
GEMINI_API_KEY=tu_gemini_key
